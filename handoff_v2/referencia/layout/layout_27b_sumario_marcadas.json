   "lines": [
    {
     "text": "Retórica dos namorados, dá-me",
     "left": 54.65,
     "right": 360.0,
     "top": 94.41,
     "bottom": 124.85,
     "baseline": 118.54,
     "baselineRel": 26.54
    },
    {
     "text": "uma comparação exata e poética",
     "left": 28,
     "right": 340.39,
     "top": 129.67,
     "bottom": 160.11,
     "baseline": 153.8,
     "baselineRel": 61.8
    },
    {
     "text": "para dizer o que foram aqueles",
     "left": 28,
     "right": 322.1,
     "top": 164.93,
     "bottom": 195.37,
     "baseline": 189.06,
     "baselineRel": 97.06
    },
    {
     "text": "olhos de Capitu. Não me acode",
     "left": 28,
     "right": 321.2,
     "top": 200.19,
     "bottom": 230.63,
     "baseline": 224.32,
     "baselineRel": 132.32
    },
    {
     "text": "imagem capaz de dizer, sem",
