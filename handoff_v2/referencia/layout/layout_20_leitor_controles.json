   },
   "css": "margin: 0; font-family: 'Literata', Georgia, serif; font-size: 20.5px; font-weight: 400; line-height: 1.72; color: #2A2520; text-align: left; text-indent: 1.3em",
   "lines": [
    {
     "text": "Retórica dos namorados, dá-me",
     "left": 54.65,
     "right": 360.0,
     "top": 94.41,
     "bottom": 124.85,
     "baseline": 118.54,
     "baselineRel": 26.54
    },
    {
     "text": "uma comparação exata e poética",
     "left": 28,
     "right": 340.39,
     "top": 129.67,
     "bottom": 160.11,
     "baseline": 153.8,
     "baselineRel": 61.8
    },
    {
     "text": "para dizer o que foram aqueles",
     "left": 28,
     "right": 322.1,
     "top": 164.93,
     "bottom": 195.37,
     "baseline": 189.06,
     "baselineRel": 97.06
    },
    {
     "text": "olhos de Capitu. Não me acode",
     "left": 28,
     "right": 321.2,
     "top": 200.19,
     "bottom": 230.63,
     "baseline": 224.32,
     "baselineRel": 132.32
    },
    {
     "text": "imagem capaz de dizer, sem",
     "left": 28,
     "right": 295.46,
     "top": 235.45,
     "bottom": 265.89,
     "baseline": 259.58,
     "baselineRel": 167.58
    },
    {
     "text": "quebra da dignidade do estilo, o",
     "left": 28,
     "right": 333.61,
     "top": 270.71,
     "bottom": 301.15,
     "baseline": 294.84,
     "baselineRel": 202.84
    },
    {
     "text": "que eles foram e me fizeram.",
     "left": 28,
     "right": 302.05,
     "top": 305.97,
     "bottom": 336.41,
     "baseline": 330.1,
     "baselineRel": 238.1
    },
    {
     "text": "Olhos de ressaca? Vá, de ressaca. É",
     "left": 28,
     "right": 357.5,
     "top": 341.23,
     "bottom": 371.67,
     "baseline": 365.36,
     "baselineRel": 273.36
    },
    {
     "text": "o que me dá ideia daquela feição",
     "left": 28,
     "right": 336.62,
     "top": 376.49,
     "bottom": 406.93,
     "baseline": 400.62,
     "baselineRel": 308.62
    },
    {
     "text": "nova. Traziam não sei que fluido",
     "left": 28,
     "right": 341.75,
     "top": 411.75,
     "bottom": 442.19,
     "baseline": 435.88,
     "baselineRel": 343.88
    },
    {
     "text": "misterioso e enérgico, uma força",
     "left": 28,
     "right": 343.35,
     "top": 447.01,
     "bottom": 477.45,
     "baseline": 471.14,
     "baselineRel": 379.14
    },
    {
     "text": "que arrastava para dentro, como a",
     "left": 28,
     "right": 355.57,
     "top": 482.27,
     "bottom": 512.71,
     "baseline": 506.4,
     "baselineRel": 414.4
    },
    {
     "text": "vaga que se retira da praia, nos",
     "left": 28,
     "right": 324.32,
     "top": 517.53,
     "bottom": 547.97,
     "baseline": 541.66,
     "baselineRel": 449.66
    },
    {
     "text": "dias de ressaca. Para não ser",
     "left": 28,
     "right": 297.89,
     "top": 552.79,
     "bottom": 583.23,
     "baseline": 576.92,
     "baselineRel": 484.92
    },
    {
     "text": "arrastado, agarrei-me às outras",
     "left": 28,
     "right": 329.46,
     "top": 588.05,
     "bottom": 618.49,
     "baseline": 612.18,
     "baselineRel": 520.18
    },
    {
     "text": "partes vizinhas, às orelhas, aos",
     "left": 28,
     "right": 325.41,
     "top": 623.31,
     "bottom": 653.75,
     "baseline": 647.44,
     "baselineRel": 555.44
    },
    {
     "text": "braços, aos cabelos espalhados",
     "left": 28,
     "right": 321.73,
     "top": 658.57,
     "bottom": 689.01,
     "baseline": 682.7,
     "baselineRel": 590.7
    },
    {
     "text": "pelos ombros; mas tão depressa",
     "left": 28,
     "right": 330.87,
     "top": 693.83,
     "bottom": 724.27,
     "baseline": 717.96,
     "baselineRel": 625.96
    },
    {
     "text": "buscava as pupilas, a onda que",
     "left": 28,
     "right": 320.33,
     "top": 729.09,
     "bottom": 759.53,
     "baseline": 753.22,
     "baselineRel": 661.22
    },
    {
     "text": "saía delas vinha crescendo, cava e",
     "left": 28,
     "right": 350.79,
     "top": 764.35,
     "bottom": 794.79,
     "baseline": 788.48,
     "baselineRel": 696.48,
     "oculta": true
    },
    {
     "text": "escura, ameaçando envolver-me,",
     "left": 28,
     "right": 345.21,
     "top": 799.61,
     "bottom": 830.05,
     "baseline": 823.74,
     "baselineRel": 731.74,
     "oculta": true
    },
    {
     "text": "puxar-me e tragar-me.",
     "left": 28,
     "right": 246.3,
     "top": 834.87,
     "bottom": 865.31,
     "baseline": 859,
     "baselineRel": 767,
     "oculta": true
    }
   ],
   "naturalWidth": 6672.012,
   "minContentWidth": 118.712,
   "text": "Retórica dos namorados, dá-me uma comparação exata e poética para dizer o que foram aqueles olhos de Capitu. Não me acode imagem capaz de dizer, sem quebra da dignidade do estilo, o que eles foram e me fizeram. Olhos de ressaca? Vá, de ressaca. É o que me dá ideia daquela feição nova. Traziam não sei que fluido misterioso e enérgico, uma força que arrastava para dentro, como a vaga que se retira da praia, nos dias de ressaca. Para não ser arrastado, agarrei-me às outras partes vizinhas, às orelhas, aos braços, aos cabelos espalhados pelos ombros; mas tão depressa buscava as pupilas, a onda que saía delas vinha crescendo, cava e escura, ameaçando envolver-me, puxar-me e tragar-me.",
   "platformFonts": [
    {
     "family": "Literata",
     "postScript": "Literata-Regular",
     "custom": true,
     "glyphs": 665
    }
   ]
  },
