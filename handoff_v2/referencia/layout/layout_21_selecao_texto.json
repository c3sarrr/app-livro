   "lines": [
    {
     "text": "Retórica dos namorados, dá-me",
     "left": 54.65,
     "right": 360.0,
     "top": 94.41,
     "bottom": 124.85,
     "baseline": 118.54,
     "baselineRel": 26.54
    },
    {
     "text": "uma comparação exata e poética",
     "left": 28,
     "right": 340.39,
     "top": 129.67,
     "bottom": 160.11,
     "baseline": 153.8,
     "baselineRel": 61.8
    },
    {
     "text": "para dizer o que foram",
     "left": 28,
     "right": 245.48,
     "top": 164.93,
     "bottom": 195.37,
     "baseline": 189.06,
     "baselineRel": 97.06
    },
    {
     "text": ". Não me acode",
     "left": 176.92,
     "right": 321.2,
     "top": 200.19,
     "bottom": 230.63,
     "baseline": 224.32,
     "baselineRel": 132.32
    },
    {
     "text": "imagem capaz de dizer, sem",
     "left": 28,
     "right": 295.46,
     "top": 235.45,
     "bottom": 265.89,
     "baseline": 259.58,
     "baselineRel": 167.58
    },
    {
     "text": "quebra da dignidade do estilo, o",
     "left": 28,
     "right": 333.61,
     "top": 270.71,
     "bottom": 301.15,
     "baseline": 294.84,
     "baselineRel": 202.84
    },
    {
     "text": "que eles foram e me fizeram. É",
     "left": 28,
     "right": 357.5,
     "top": 305.97,
     "bottom": 371.67,
     "baseline": 330.1,
     "baselineRel": 238.1,
     "baselineSpread": 35.26
    },
    {
     "text": "o que me dá ideia daquela feição",
     "left": 28,
     "right": 336.62,
     "top": 376.49,
     "bottom": 406.93,
     "baseline": 400.62,
     "baselineRel": 308.62
    },
    {
     "text": "nova. Traziam não sei que fluido",
     "left": 28,
     "right": 341.75,
     "top": 411.75,
     "bottom": 442.19,
     "baseline": 435.88,
     "baselineRel": 343.88
    },
    {
     "text": "misterioso e enérgico, uma força",
     "left": 28,
     "right": 343.35,
     "top": 447.01,
     "bottom": 477.45,
     "baseline": 471.14,
     "baselineRel": 379.14
    },
    {
     "text": "que arrastava para dentro,",
     "left": 28,
     "right": 282.77,
     "top": 482.27,
     "bottom": 512.71,
     "baseline": 506.4,
     "baselineRel": 414.4
    },
    {
     "text": "Para não ser",
     "left": 180.03,
     "right": 297.89,
     "top": 552.79,
     "bottom": 583.23,
     "baseline": 576.92,
     "baselineRel": 484.92
    },
    {
     "text": "arrastado, agarrei-me às outras",
     "left": 28,
     "right": 329.46,
     "top": 588.05,
     "bottom": 618.49,
     "baseline": 612.18,
     "baselineRel": 520.18
    },
    {
     "text": "partes vizinhas, às orelhas, aos",
     "left": 28,
