# Segredos das Edge Functions — modelo (só os NOMES). O arquivo de verdade é supabase/functions/.env
# (fora do git) no local, e `supabase secrets set --env-file …` em stg/prod. Nunca cole valores no chat.
#
# Já existem no Supabase (não definir): SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_SECRET_KEYS (ou
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY no local), SUPABASE_PUBLISHABLE_KEYS (ou
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY). O agendador (pg_cron) chama as funções com uma chave
# secreta do projeto guardada no Vault (booknest_scheduler_key) — ver a migration de agendamentos.

# SÓ no local: o Deno não resolve o nome do contêiner do banco (tem "_"). Use a porta do host:
# postgresql://postgres:postgres@host.docker.internal:54322/postgres
BOOKNEST_DB_URL=

# revenuecat-webhook: valor exato do cabeçalho Authorization configurado no webhook do RevenueCat
REVENUECAT_WEBHOOK_AUTH=
# revenuecat-webhook e delete-account: chave secreta (v1) da API REST do RevenueCat
REVENUECAT_API_KEY=

# isbn-lookup (opcionais; sem elas só a BrasilAPI é consultada). ISBNdb é pago: só se o volume pedir.
HARDCOVER_TOKEN=
ISBNDB_KEY=

# email-sender (Resend). Remetente, ex.: BookNest <nao-responda@SEU-DOMINIO> (domínio pendente: Q9)
RESEND_API_KEY=
BOOKNEST_EMAIL_FROM=

# push-sender: JSON da conta de serviço do Firebase (FCM HTTP v1), numa linha só
FCM_SERVICE_ACCOUNT=
