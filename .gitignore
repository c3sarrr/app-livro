# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# G01: saída derivada da extração das pranchas (regenerável; só o relatório de hashes é versionado)
tools/medicao/pranchas/*
!tools/medicao/pranchas/extracao.json
tools/medicao/tmp/

# G02: dados baixados pelos spikes (EPUB de domínio público etc.) e dependências Node
spikes/_dados/
node_modules/
spikes/**/build/
# G04: segredos e configuração por ambiente — só os modelos vão para o git
.env
.env.*
!.env.example
env/*.json
!env/*.example.json
# G06: estado e segredos de DESENVOLVIMENTO local (senha do papel do PowerSync, tokens) — nunca no git
/_local/
# G07: caches do Python (pipeline do catálogo) e estado local do Worker (wrangler/Miniflare)
__pycache__/
.pytest_cache/
.wrangler/
.dev.vars
